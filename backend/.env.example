PORT=5001

# Flask and JWT secret keys (each must be at least 32 characters long)
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-chars-long
JWT_SECRET_KEY=replace-with-a-different-jwt-secret-at-least-32-chars

# Database: Leave unset to use backend/instance/campusfix.db
# DATABASE_URL=sqlite:///instance/campusfix.db

# Optional Google Gemini API Key for complaint classification
GEMINI_API_KEY=
AI_ENABLED=false
AI_DAILY_LIMIT=25

# Frontend configuration
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=development

# Admin account (set real password before running seed.py)
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=AdminCampusFix2026!
ADMIN_NAME=Campus Administrator

# Optional Staff account
DEMO_STAFF_EMAIL=staff@college.edu
DEMO_STAFF_PASSWORD=StaffCampusFix2026!
DEMO_STAFF_NAME=Maintenance Staff
DEMO_STAFF_DEPARTMENT=Electrical Maintenance

# Optional Student account
DEMO_STUDENT_EMAIL=student@college.edu
DEMO_STUDENT_PASSWORD=StudentCampusFix2026!
DEMO_STUDENT_NAME=Alex Rivera
